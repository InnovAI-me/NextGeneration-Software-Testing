
.venv/
venv/
__pycache__/
*.pyc

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.pdf
paper/sections/*.aux

# Data (keep raw exports out of git if large/licensed; adjust as needed)
data/raw/*
!data/raw/.gitkeep
!data/raw/reference-list.xlsx
data/processed/*
!data/processed/.gitkeep

# Downloaded full-text PDFs are typically copyrighted (publisher/arXiv license
# terms vary) - keep them local only. Only the fetch manifest/log is tracked.
data/papers/*
!data/papers/.gitkeep
!data/papers/fetch-log.csv

# OS / editor
.DS_Store
Thumbs.db

